{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "villacde-core/booking-form",
	"title": "Villa CDE Booking Form",
	"category": "design",
	"icon": "calendar-alt",
	"description": "Booking request form with a two-month date-range picker that hands the finished request to WhatsApp — there is no backend.",
	"textdomain": "villacde-core",
	"supports": {
		"anchor": true
	},
	"attributes": {
		"maxGuests": { "type": "number", "default": 12 },
		"nightlyRate": { "type": "number", "default": 65000 },
		"currency": { "type": "string", "default": "KES" },
		"whatsappNumber": { "type": "string", "default": "254713234606" }
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style-index.css"
}
